# CLI Manager Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# GitHub Token (Optional)
# ============================================
# Optional: GitHub personal access token
# gh CLI auth is recommended instead (run: gh auth login)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo, workflow
GH_TOKEN=

# ============================================
# Development Settings (Optional)
# ============================================
# Skip terminal session restore on startup (set to "true" to skip)
# VITE_NO_SESSION_RESTORE=false

# =============================================================================
# Feedback widget (Optional)
# =============================================================================
# Lasso Run source `climanager-app`. Inlined at build time — a build without them has no
# feedback widget. Put them in .env.local (gitignored); the key is publishable but is never committed.
# VITE_DP_FEEDBACK_URL=https://<ref>.supabase.co/functions/v1/dp-agentation-ingest/<sourceId>
# VITE_DP_FEEDBACK_KEY=
